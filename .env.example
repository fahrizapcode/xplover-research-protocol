# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/xplover

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Server
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Blockchain - Arbitrum Sepolia
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
PRIVATE_KEY=your-deployer-wallet-private-key-never-commit-this
ARBITRUM_SEPOLIA_CHAIN_ID=421614

# Contract Addresses (populated after deployment)
XCR_CONTRACT_ADDRESS=
CONTRIBUTION_CONTRACT_ADDRESS=

# Blockchain Feature Flag (set to false to disable blockchain calls)
BLOCKCHAIN_ENABLED=false
